# Copy to .env for local dev. NEVER commit real values. All of these are Railway
# env vars in production — see RAILWAY_BRIEF.md §4 for what each one is.

ENV=dev
DATABASE_URL=postgresql://localhost:5432/social_review

# >= 32 random bytes:  openssl rand -hex 32
API_TOKEN=

# MUST be from the developer app owned by @SwarajyaMag itself — see §10 Owned Reads.
X_BEARER_TOKEN=
X_USER_ID=2451476942
X_MAX_POSTS_PER_RUN=1500
X_BALANCE_ALERT_USD=20

# Long-lived Page token: pages_read_engagement, pages_show_list, instagram_basic,
# instagram_manage_insights
META_ACCESS_TOKEN=
FB_PAGE_ID=670321879700525
IG_USER_ID=17841400214702908
META_API_VERSION=v21.0

WEEK_TZ=Asia/Kolkata

# Delivery is Google Chat, not email (see CLAUDE.md amendments). Create an incoming
# webhook in the target room: room -> Apps & integrations -> Webhooks.
GOOGLE_CHAT_WEBHOOK=
# Public URL of the api service, for signed PDF links in Chat messages.
PUBLIC_BASE_URL=
