# Required
DASHBOARD_PASSWORD=changeme
SESSION_SECRET=generate-a-random-32-char-string

# Optional — only needed when brief generation is wired in (step 7).
# Without it, the app boots and shows raw RSS titles instead of Claude briefs.
# ANTHROPIC_API_KEY=sk-ant-xxx

# Optional - sane defaults if missing
CLAUDE_MODEL=claude-haiku-4-5-20251001
DATABASE_PATH=data/app.db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOG_LEVEL=INFO

# Tunables (mostly leave alone)
FETCH_TIMEOUT_SECONDS=20
ENRICH_LOOKBACK_HOURS=72
DEDUP_SIMILARITY_THRESHOLD=0.95
CLUSTER_SIMILARITY_THRESHOLD=0.80
TOP_N_FOR_BRIEFS=100

# User-Agent contact (operator email)
USER_AGENT_CONTACT=amar@swarajyamag.com
