{
  "name": "remox-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remox Studio — Browser-based production interface for Remox",
  "scripts": {
    "dev": "node scripts/start.mjs",
    "dev:server": "tsx --tsconfig tsconfig.server.json server.ts",
    "dev:vite": "vite --port 3848",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "@remotion/player": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "chokidar": "^3.6.0",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "wavesurfer.js": "^7.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.1"
  }
}
