# Quintype content API root for Swarajya
QUINTYPE_BASE_URL=https://swarajyamag.com

# Anthropic — only used by the REST /ask synthesis path (MCP tools that return
# raw sources do not call an LLM). Leave blank to disable server-side synthesis.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8

# Orchestration limits
MAX_CONTEXT_STORIES=8
REQUEST_TIMEOUT=45
LOG_LEVEL=INFO

# --- Auth / clients (spec §8) ---
# Client + token store. Default: local SQLite. For production use Postgres:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host/db   (pip install asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./swarajya_mcp.db

# Admin key gating the /admin console + /admin/api/* (client/token management).
# Generate one: openssl rand -hex 24 . Leave empty to disable the admin surface.
ADMIN_API_KEY=

# Defaults applied to any grant without an explicit override (overridable per
# grant in the admin console). Per-minute is burst protection (keep generous
# for agentic multi-tool turns); monthly is the real budget cap.
RATE_LIMIT_PER_MINUTE_DEFAULT=20
MONTHLY_REQUEST_QUOTA_DEFAULT=250

# Public origin used to build per-subscriber URLs (<origin>/s/<token>/mcp) shown
# in the admin console. Set to your real HTTPS origin in production.
PUBLIC_BASE_URL=http://localhost:8000

# Set true to skip client-bearer auth on /api and /mcp (LOCAL DEV ONLY).
DISABLE_AUTH=false

# NOTE: clients/tokens are now DB-backed with bcrypt-hashed secrets, managed via
# the /admin console. For end-user MCP connectors, OAuth 2.1 is still the
# standards-track upgrade over static bearer tokens — see CLAUDE.md.
